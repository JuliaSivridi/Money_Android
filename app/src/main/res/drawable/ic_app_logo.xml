<?xml version="1.0" encoding="utf-8"?>
<!--
  App logo for AuthScreen (72dp display).
  30×30 viewport, orange rounded-rect background with a white wallet glyph
  (body + flap crease + clasp), scaled/centered the same way as the Tasks
  sibling app's logo for visual family resemblance.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="30"
    android:viewportHeight="30">

    <!-- Orange rounded-rect background (full viewport) -->
    <path
        android:pathData="M3,0 L27,0 A3,3 0 0 1 30,3 L30,27 A3,3 0 0 1 27,30 L3,30 A3,3 0 0 1 0,27 L0,3 A3,3 0 0 1 3,0 Z"
        android:fillColor="#E0813D" />

    <!-- Wallet glyph, centered content bbox x[2,28] y[8,24] -->
    <group
        android:translateX="3.3"
        android:translateY="2.52"
        android:scaleX="0.78"
        android:scaleY="0.78">

        <!-- Wallet body: stroke-only rounded rect -->
        <path
            android:pathData="M5,8 L25,8 A3,3 0 0 1 28,11 L28,21 A3,3 0 0 1 25,24 L5,24 A3,3 0 0 1 2,21 L2,11 A3,3 0 0 1 5,8 Z"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8" />

        <!-- Flap crease -->
        <path
            android:pathData="M2,13 L28,13"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />

        <!-- Clasp -->
        <path
            android:pathData="M19.7,16 A2.3,2.3 0 1 1 24.3,16 A2.3,2.3 0 1 1 19.7,16 Z"
            android:fillColor="#FFFFFF" />

    </group>

</vector>
