<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device-transfer rules (API 31+).
   auth_prefs DataStore holds the Google access token — keep it out of
   cloud backups and device-to-device transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_prefs.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
